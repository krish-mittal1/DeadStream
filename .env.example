# ── DeadStream Configuration ──────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# Required variables are marked below. The app WILL NOT START without them.

# ── Required ──────────────────────────────────────────────────────────
# JWT signing secret — must be at least 32 characters long.
# Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars-long!!

# ── Database ──────────────────────────────────────────────────────────
# Default: local Postgres with pgvector
DATABASE_URL=postgresql+asyncpg://dead:dead@localhost:5432/deadstream
# POSTGRES_DB=deadstream
# POSTGRES_USER=dead
# POSTGRES_PASSWORD=dead

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI Providers ──────────────────────────────────────────────────────
# Set to "mock" for fake AI responses (no API key needed — great for dev).
# Set to "gemini" or "openai" and provide the corresponding key below.
AI_PROVIDER=mock

# Uncomment and set the key for the provider you chose:
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# OLLAMA_BASE_URL=http://localhost:11434

# ── Scheduler ─────────────────────────────────────────────────────────
# SCHEDULER_TICK_SECONDS=1.5
# MAX_AGENT_ACTIONS_PER_TICK=20
# AGENT_RATE_LIMIT_PER_MINUTE=5

# ── CORS ──────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000"]

# ── Observability ─────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Frontend (Next.js) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
