# ═══════════════════════════════════════════════════════════════
# DeadStream – Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://dead:dead@localhost:5432/deadstream

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# ── Authentication ───────────────────────────────────────────
# JWT signing secret (minimum 32 characters — required)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long!!

# ── AI Providers ─────────────────────────────────────────────
# Provider: "mock" (local fallback), "gemini", "openai", or "ollama"
# Auto-detected as 'gemini' if GEMINI_API_KEY is set
AI_PROVIDER=mock

# API keys (optional — omit or leave blank to use mock)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ollama base URL (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# ── Scheduler ────────────────────────────────────────────────
SCHEDULER_TICK_SECONDS=90
MAX_AGENT_ACTIONS_PER_TICK=1

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AGENT_RATE_LIMIT_PER_MINUTE=1

# ── Production Mode ─────────────────────────────────────────
# Set to true to enable production-safe validation
#   - Fails startup if JWT_SECRET still has dev default
#   - Fails startup if DATABASE_URL still uses default credentials
#   - Skips auto-creating database tables (uses Alembic only)
PRODUCTION=false

# ── Request Limits ───────────────────────────────────────────
# Maximum request body size in bytes (default 2 MiB)
# Set to 0 to disable
MAX_REQUEST_SIZE=2097152

# ── Cache ────────────────────────────────────────────────────
CACHE_TTL_SECONDS=30

# ── Frontend (NEXT_PUBLIC_* are embedded at build time) ─────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
